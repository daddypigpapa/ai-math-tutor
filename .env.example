# 이 파일을 .env 로 복사해 채운다. .env 는 깃에 올리지 않는다.
# 우선순위(낮음→높음): ~/claude/key.env  <  이 폴더의 .env  <  실제 환경변수
# 작업별 키 이름은 config.toml 의 key_env·model_env 가 정한다.
ANTHROPIC_API_KEY=
# 코칭·계산단계 설명·주간 보고서 (coach·step_help·report)
COACHING_GEMINI_API_KEY=
COACHING_GEMINI_API_MODEL=
# 문제집 사진 OCR (모델을 비우면 config.toml [tasks.ocr] model)
VISION_OCR_GEMINI_API_KEY=
VISION_OCR_GEMINI_API_MODEL=
# 평가 채점(judge_generate) 등 key_env 가 없는 Gemini 작업
GEMINI_API_KEY=
DISCORD_WEBHOOK_URL=
# 부모 화면(/parent) 비밀번호. 비워 두면 부모 화면이 잠긴다.
PARENT_PIN=
