# 이 파일을 .env 로 복사해 채운다. .env 는 깃에 올리지 않는다.
# 우선순위(낮음→높음): ~/claude/key.env  <  이 폴더의 .env  <  실제 환경변수
ANTHROPIC_API_KEY=
AI_TUTOR_GEMINI_API_KEY=
# config.toml 에 model 이 없는 Gemini 작업(coach·step_help·report)이 쓰는 모델
AI_TUTOR_GEMINI_API_MODEL=
DISCORD_WEBHOOK_URL=
# 부모 화면(/parent) 비밀번호. 비워 두면 부모 화면이 잠긴다.
PARENT_PIN=
